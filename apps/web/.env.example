# App environment: "development" or "production". Falls back to development.
NEXT_PUBLIC_APP_ENV=

# Active chain id: 421614 (Arbitrum Sepolia) for dev/testnet, 42161 (Arbitrum One) for mainnet.
NEXT_PUBLIC_CHAIN_ID=

# Deployed vault-core contract address (Stylus, per-user allocation model, D-01..D-33 of 14-CONTEXT.md).
# There is no periphery address to configure: Permit2 was dropped (D-08), core.deposit(uint256) is
# the only entrypoint for USDC in.
NEXT_PUBLIC_CORE_ADDRESS=

# USDC address for the active network.
# Arbitrum Sepolia: 0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
# Arbitrum One:      0xaf88d065e77c8cC2239327C5EDb3A432268e5831
NEXT_PUBLIC_USDC_ADDRESS=

# Morpho ERC-4626 adapter address for the active network.
NEXT_PUBLIC_MORPHO_ADAPTER_ADDRESS=

# Fluid ERC-4626 adapter address for the active network.
NEXT_PUBLIC_FLUID_ADAPTER_ADDRESS=

# Euler ERC-4626 adapter address for the active network (D-27: replaces Beefy).
NEXT_PUBLIC_EULER_ADAPTER_ADDRESS=

# Aave (via Stata wrapper) adapter address for the active network.
NEXT_PUBLIC_AAVE_ADAPTER_ADDRESS=

# WalletConnect Cloud project id for RainbowKit. Empty falls back to an injected-only wagmi config.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Lemon Mini App id issued by the Lemon team. Empty forces the local Lemon bridge mock (D-01/D-02).
NEXT_PUBLIC_LEMON_MINI_APP_ID=

# Dev-only: enables the fault-injection panel for the Lemon bridge mock (D-17/D-18). Never set in
# production; the panel is a developer tool, never shown to end users.
NEXT_PUBLIC_FAULT_INJECTION=

# HMAC secret used to sign the SIWE nonce cookie (D-03, inherited from CoinFlip F6 D-15). Required
# in any environment that serves the Lemon WebView SIWE routes; never commit a real value.
SIWE_COOKIE_SECRET=
